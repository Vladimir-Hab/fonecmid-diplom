
#Область ОбработчикиФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда
		ДобавитьРеквизитыНаФорму();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ПараметрыЗаписи)

	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда

		ТекстОшибки = "";

		Если Не ЗначениеЗаполнено(Объект.ВКМ_ДатаНачала) Тогда
			ТекстОшибки = ТекстОшибки + "• Не заполнена дата начала" + Символы.ПС;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Объект.ВКМ_ДатаОкончания) Тогда
			ТекстОшибки = ТекстОшибки + "• Не заполнена дата окончания" + Символы.ПС;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Объект.ВКМ_АбонентскаяПлата) Или Объект.ВКМ_АбонентскаяПлата <= 0 Тогда
			ТекстОшибки = ТекстОшибки + "• Не заполнена абонентская плата или указано некорректное значение"
				+ Символы.ПС;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Объект.ВКМ_СтоимостьЧаса) Или Объект.ВКМ_СтоимостьЧаса <= 0 Тогда
			ТекстОшибки = ТекстОшибки + "• Не заполнена стоимость часа или указано некорректное значение" + Символы.ПС;
		КонецЕсли;

		Если ТекстОшибки <> "" Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для абонентского обслуживания необходимо заполнить:" + Символы.ПС + ТекстОшибки;
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;

	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиРеквизитов

&НаСервере
Процедура ВидДоговораПриИзмененииНаСервере()

	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда
		ДобавитьРеквизитыНаФорму();
	Иначе
		УдалитьДополнительныеРеквизиты();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораПриИзменении(Элемент)
	ВидДоговораПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти


#Область ПрограммныйИнтерфейс

&НаСервере
Процедура ДобавитьРеквизитыНаФорму()

	Группа = Элементы.Добавить("ВКМ", Тип("ГруппаФормы"), ЭтаФорма);
	Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	ПолеДатаНачала = Элементы.Добавить("ВКМ_ДатаНачала", Тип("ПолеФормы"), Группа);
	ПолеДатаНачала.Вид = ВидПоляФормы.ПолеВвода;
	ПолеДатаНачала.ПутьКДанным = "Объект.ВКМ_ДатаНачала";
	ПолеДатаНачала.Заголовок = "Дата начала";

	ПолеДатаОкончания = Элементы.Добавить("ВКМ_ДатаОкончания", Тип("ПолеФормы"), Группа);
	ПолеДатаОкончания.Вид = ВидПоляФормы.ПолеВвода;
	ПолеДатаОкончания.ПутьКДанным = "Объект.ВКМ_ДатаОкончания";
	ПолеДатаОкончания.Заголовок = "Дата окончания";

	ПолеАбонентскаяПлата = Элементы.Добавить("ВКМ_АбонентскаяПлата", Тип("ПолеФормы"), Группа);
	ПолеАбонентскаяПлата.Вид = ВидПоляФормы.ПолеВвода;
	ПолеАбонентскаяПлата.ПутьКДанным = "Объект.ВКМ_АбонентскаяПлата";
	ПолеАбонентскаяПлата.Заголовок = "Абонентская плата";

	ПолеСтоимостьЧаса = Элементы.Добавить("ВКМ_СтоимостьЧаса", Тип("ПолеФормы"), Группа);
	ПолеСтоимостьЧаса.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСтоимостьЧаса.ПутьКДанным = "Объект.ВКМ_СтоимостьЧаса";
	ПолеСтоимостьЧаса.Заголовок = "Стоимость часа";

КонецПроцедуры

&НаСервере
Процедура УдалитьДополнительныеРеквизиты()

   ОбнулитьРеквизиты();
   
    МассивИмен = Новый Массив;
    МассивИмен.Добавить("ВКМ_ДатаНачала");
    МассивИмен.Добавить("ВКМ_ДатаОкончания");
    МассивИмен.Добавить("ВКМ_АбонентскаяПлата");
    МассивИмен.Добавить("ВКМ_СтоимостьЧаса");
    
    Для Каждого ИмяЭлемента Из МассивИмен Цикл
        Элемент = Элементы.Найти(ИмяЭлемента);
        Если Элемент <> Неопределено Тогда
            Элементы.Удалить(Элемент);
        КонецЕсли;
    КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбнулитьРеквизиты()
    
    Если ЗначениеЗаполнено(Объект.ВКМ_ДатаНачала) Тогда
        Объект.ВКМ_ДатаНачала = '00010101';
    КонецЕсли;
    
    Если ЗначениеЗаполнено(Объект.ВКМ_ДатаОкончания) Тогда
        Объект.ВКМ_ДатаОкончания = '00010101';
    КонецЕсли;
    
    Если ЗначениеЗаполнено(Объект.ВКМ_АбонентскаяПлата) Тогда
        Объект.ВКМ_АбонентскаяПлата = 0;
    КонецЕсли;
    
    Если ЗначениеЗаполнено(Объект.ВКМ_СтоимостьЧаса) Тогда
        Объект.ВКМ_СтоимостьЧаса = 0;
    КонецЕсли;
    
КонецПроцедуры

#КонецОбласти