&НаСервере
Процедура ВидДоговораПриИзмененииНаСервере()

Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда
ДобавитьРеквизитыНаФорму();
Иначе
УдалитьДополнительныеРеквизиты();
КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидДоговораПриИзменении(Элемент)
ВидДоговораПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыНаФорму()

ГруппаДополнительные = Элементы.Дополнительные;

ПолеДатаНачала = Элементы.Добавить("ВКМ_ДатаНачала", Тип("ПолеФормы"));
ПолеДатаНачала.Вид = ВидПоляФормы.ПолеВвода;
ПолеДатаНачала.ПутьКДанным = "Объект.ВКМ_ДатаНачала";
ПолеДатаНачала.Заголовок = "Дата начала";

ПолеДатаОкончания = Элементы.Добавить("ВКМД_атаОкончания", Тип("ПолеФормы"));
ПолеДатаОкончания.Вид = ВидПоляФормы.ПолеВвода;
ПолеДатаОкончания.ПутьКДанным = "Объект.ВКМ_ДатаОкончания";
ПолеДатаОкончания.Заголовок = "Дата окончания";

ПолеАбонентскаяПлата = Элементы.Добавить("ВКМ_АбонентскаяПлата", Тип("ПолеФормы"));
ПолеАбонентскаяПлата.Вид = ВидПоляФормы.ПолеВвода;
ПолеАбонентскаяПлата.ПутьКДанным = "Объект.ВКМ_АбонентскаяПлата";
ПолеАбонентскаяПлата.Заголовок = "Абонентская плата";

ПолеСтоимостьЧаса = Элементы.Добавить("ВКМ_СтоимостьЧаса", Тип("ПолеФормы"));
ПолеСтоимостьЧаса.Вид = ВидПоляФормы.ПолеВвода;
ПолеСтоимостьЧаса.ПутьКДанным = "Объект.ВКМ_СтоимостьЧаса";
ПолеСтоимостьЧаса.Заголовок = "Стоимость часа";

КонецПроцедуры

&НаСервере
Процедура УдалитьДополнительныеРеквизиты()
	
	Элемент = Элементы.Найти("ВКМ_ДатаНачала");
	Если Элемент <> Неопределено Тогда
		Элементы.Удалить(Элемент);
	КонецЕсли;
	
	Элемент = Элементы.Найти("ВКМ_ДатаОкончания");
	Если Элемент <> Неопределено Тогда
		Элементы.Удалить(Элемент);
	КонецЕсли;
	
	Элемент = Элементы.Найти("ВКМ_АбонентскаяПлата");
	Если Элемент <> Неопределено Тогда
		Элементы.Удалить(Элемент);
	КонецЕсли;
	
	Элемент = Элементы.Найти("ВКМ_СтоимостьЧаса");
	Если Элемент <> Неопределено Тогда
		Элементы.Удалить(Элемент);
	КонецЕсли;
	
КонецПроцедуры
