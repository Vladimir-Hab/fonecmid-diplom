
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ПараметрыЗаписи)

Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда

ТекстОшибки = "";

// Проверка всех реквизитов
Если Не ЗначениеЗаполнено(Объект.ВКМ_ДатаНачала) Тогда
ТекстОшибки = ТекстОшибки + "• Не заполнена дата начала" + Символы.ПС;
КонецЕсли;

Если Не ЗначениеЗаполнено(Объект.ВКМ_ДатаОкончания) Тогда
ТекстОшибки = ТекстОшибки + "• Не заполнена дата окончания" + Символы.ПС;
КонецЕсли;

Если Не ЗначениеЗаполнено(Объект.ВКМ_АбонентскаяПлата) ИЛИ Объект.ВКМ_АбонентскаяПлата <= 0 Тогда
ТекстОшибки = ТекстОшибки + "• Не заполнена абонентская плата или указано некорректное значение" + Символы.ПС;
КонецЕсли;

Если Не ЗначениеЗаполнено(Объект.ВКМ_СтоимостьЧаса) ИЛИ Объект.ВКМ_СтоимостьЧаса <= 0 Тогда
ТекстОшибки = ТекстОшибки + "• Не заполнена стоимость часа или указано некорректное значение" + Символы.ПС;
КонецЕсли;

// Если есть ошибки - выводим сообщение
Если ТекстОшибки <> "" Тогда
Сообщение = Новый СообщениеПользователю;
Сообщение.Текст = "Для абонентского обслуживания необходимо заполнить:" + Символы.ПС + ТекстОшибки;
Сообщение.Сообщить();
КонецЕсли;

КонецЕсли;
КонецПроцедуры

