#Область ПрограммныйИнтерфейс

Процедура ОтправитьУведомленияВТелеграмм() Экспорт
	
	ТокенБота = Константы.ВКМ_ТокенУправленияТелеграмБотом.Получить();
	
	Если Не ЗначениеЗаполнено(ТокенБота) Тогда
		ОбщегоНазначения.СообщитьПользователю("Сообщение не отправлено. Токен для Телегамм не установлен.");
		Возврат;
	КонецЕсли;
	
	ИдентификаторЧата = Константы.ВКМ_ТелеграмГруппа.Получить();
	Если Не ЗначениеЗаполнено(ИдентификаторЧата) Тогда
		ОбщегоНазначения.СообщитьПользователю("Сообщение не отправлено. Идентификатор чата для Телеграмм не установлен.");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВКМ_УведомлениеТелеграм.Ссылка КАК Ссылка,
	               |	ВКМ_УведомлениеТелеграм.ТекстСообщения КАК ТекстСообщения
	               |ИЗ
	               |	Справочник.ВКМ_УведомлениеТелеграм КАК ВКМ_УведомлениеТелеграм";

	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл
		
		Ответ = ОтправитьСообщениеВТелеграм(ТокенБота, ИдентификаторЧата, Выборка.ТекстСообщения);
		Если Ответ = Неопределено Тогда
			Продолжить;	
		КонецЕсли; 
		
		Если Ответ.Успех Тогда
			Запись = Выборка.Ссылка.ПолучитьОбъект();	
			Запись.Удалить();
		Иначе
			ОписаниеОшибки = Ответ.ПолучитьТелоКакСтроку();	
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Отправка сообщений в телеграмм. Сообщение не отправлено.", УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтправитьСообщениеВТелеграм(ТокенБота, ИдентификаторЧата, ТекстСообщения)
    
//URL = "https://api.telegram.org/bot" + ТокенБота + "/sendMessage";
    
ПараметрыЗапроса = Новый Структура;
ПараметрыЗапроса.Вставить("chat_id", ИдентификаторЧата);
ПараметрыЗапроса.Вставить("text", ТекстСообщения);

Попытка
    HTTPЗапрос = Новый HTTPЗапрос("/bot" + ТокенБота + "/sendMessage");
    HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ПараметрыЗапроса);
    ТелоЗапроса = ЗаписьJSON.Закрыть();
    
    HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
    
    HTTPСоединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL());
    
    Ответ = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
    
    // Исправлено: правильное обращение к коду состояния
    Если Ответ.КодСостояния = 200 Тогда
        Результат = Новый Структура;
        Результат.Вставить("Успех", Истина);
        Результат.Вставить("Сообщение", "Сообщение успешно отправлено");
        
        ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
        
        Если НЕ ПустаяСтрока(ТелоОтвета) Тогда
            ЧтениеJSON = Новый ЧтениеJSON;
            ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
            ОтветJSON = ПрочитатьJSON(ЧтениеJSON);
            Результат.Вставить("ДанныеОтвета", ОтветJSON);
        КонецЕсли;
        
    Иначе
        Результат = Новый Структура;
        Результат.Вставить("Успех", Ложь);
        Результат.Вставить("КодОшибки", Ответ.КодСостояния);
        Результат.Вставить("Сообщение", "Ошибка при отправке сообщения: " + Ответ.ПолучитьТелоКакСтроку());
    КонецЕсли;
    
Исключение
    Результат = Новый Структура;
    Результат.Вставить("Успех", Ложь);
    Результат.Вставить("Сообщение", "Ошибка: " + ОписаниеОшибки());
КонецПопытки;

Возврат Результат;

КонецФункции
	
#КонецОбласти 

 