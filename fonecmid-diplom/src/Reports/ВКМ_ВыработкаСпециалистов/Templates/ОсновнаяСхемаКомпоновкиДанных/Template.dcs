				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Всего часов расход</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВсегоЧасовПриход</dataPath>
			<field>ВсегоЧасовПриход</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Всего часов приход</v8:content>
