
#Область ГлобальныеПеременныеМодуляФормы

&НаКлиенте
Перем НачалоМесяца, КонецМесяца;

#КонецОбласти

///////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТекущийПользователь = ПолучитьСсылкуНаТекущегоПользователя();
	Пользователи.Добавить(ТекущийПользователь);
	Календарь = ТекущаяДата();
	ВремяНачалаРабочегоДня = ВКМ_ОбщийСерверныйМодуль.ПолучитьВремяНачалаРабочегоДня();
	// Тип периода по умолчанию - День
	ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.День");
	// Настройка и заполнение планировщика
	УстановкаТекущегоПериодаОтображения(Календарь);
	НастройкаСвойствПланировщика();
КонецПроцедуры 

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Обновить время начала рабочего дня" Тогда
		// Производим настройку отображения 
		ВремяНачалаРабочегоДня = ВКМ_ОбщийСерверныйМодуль.ПолучитьВремяНачалаРабочегоДня();	
		НастройкаСвойствПланировщика();
		//Заполняем заново
	ИначеЕсли ИмяСобытия = "Обновить данные планировщика" Тогда
		ЗаполнитьПланировщикНаСервере();	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти 

///////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТипПериодаОтображенияПриИзменении(Элемент)
	НастройкаСвойствПланировщика(); 
	// Величина в секундах
	Разница = Планировщик.ТекущиеПериодыОтображения[0].Конец - Планировщик.ТекущиеПериодыОтображения[0].Начало;
	// Переключаемся с месяца
	Если Разница > 86400 * 7 Тогда 
		// Нынешний месяц (получаем глобально)
		Если ТекущаяДата() >= НачалоМесяца И ТекущаяДата() <= КонецМесяца Тогда 
			// Текущий день или неделя
			УстановкаТекущегоПериодаОтображения(ТекущаяДата());
		Иначе 
			// Первый день или неделя месяца
			УстановкаТекущегоПериодаОтображения(НачалоМесяца);
		КонецЕсли;
		// Переключаемся с недели
	ИначеЕсли Разница > 86400 Тогда
		Если 
			// Нынешний месяц
			ТекущаяДата() >= Планировщик.ТекущиеПериодыОтображения[0].Начало И 
			ТекущаяДата() <= Планировщик.ТекущиеПериодыОтображения[0].Конец Тогда
			УстановкаТекущегоПериодаОтображения(ТекущаяДата());
		Иначе 
			// Первый день нашей недели или неделя в месяце
			УстановкаТекущегоПериодаОтображения(Планировщик.ТекущиеПериодыОтображения[0].Начало);		
		КонецЕсли;  
	Иначе 
		//Неделя или месяц с нашим днем
		УстановкаТекущегоПериодаОтображения(Планировщик.ТекущиеПериодыОтображения[0].Начало);	
	КонецЕсли;  
	
	// Не день - отключаем отображение задач по всем пользователям
	Если ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.День") Тогда
		Элементы.ОтображатьЗадачиНесколькихПользователей.Видимость = Истина;
	Иначе
		Элементы.ОтображатьЗадачиНесколькихПользователей.Видимость = Ложь;
		// Снимаем галочку
		ОтображатьЗадачиНесколькихПользователей = Ложь;
	КонецЕсли;
	// Очищаем список
	ОтображатьЗадачиНесколькихПользователейПриИзменении(Элементы.ОтображатьЗадачиНесколькихПользователей);	
КонецПроцедуры 

&НаКлиенте
Процедура ФильтрыПриИзменении(Элемент)
	ЗаполнитьПланировщикНаСервере();
	
	Если
		Статусы.Количество() = 0 И
		Приоритеты.Количество() = 0 И
		Категории.Количество() = 0
	Тогда
		Элементы.ГруппаФильтры.Заголовок = "Фильтры";
	Иначе
		Элементы.ГруппаФильтры.Заголовок = "Фильтры (установлены)";
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ОтображатьЗадачиНесколькихПользователейПриИзменении(Элемент)
	Если ОтображатьЗадачиНесколькихПользователей Тогда
		Элементы.Пользователи.Видимость = Истина;
	Иначе
		Элементы.Пользователи.Видимость = Ложь;
		Пользователи.Очистить();
		Пользователи.Добавить(ТекущийПользователь);
	КонецЕсли;
	ЗаполнитьПланировщикНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПользователиПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Пользователи) Тогда
		Пользователи.Добавить(ТекущийПользователь);
	КонецЕсли;
	ЗаполнитьПланировщикНаСервере();
КонецПроцедуры

#Область ОбработчикиСобытийКомандФормы 

// Обработчик команды по смене на отображаемый период с текущей датой
&НаКлиенте
Процедура Сегодня(Команда)
	УстановкаТекущегоПериодаОтображения(ТекущаяДата());
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанные(Команда)
	ЗаполнитьПланировщикНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КалендарьПриИзменении(Элемент)
	УстановкаТекущегоПериодаОтображения(Календарь);
	Элементы.ГруппаВыборДаты.Скрыть();
КонецПроцедуры

#КонецОбласти   

#КонецОбласти

///////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийПоляПланировщика 

&НаКлиенте
Процедура ПланировщикПриСменеТекущегоПериодаОтображения(Элемент, ТекущиеПериодыОтображения, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь; 
	// Берем время начала для дня и недели 
	ДатаОтображения = ТекущиеПериодыОтображения[0].Начало; 
	// Для месяца меняем значение
	Если ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.Месяц") Тогда
		ДатаОтображения = ?(Планировщик.ТекущиеПериодыОтображения[0].ВремяНачалаПлан > ТекущиеПериодыОтображения[0].Начало,
		ДобавитьМесяц(НачалоМесяца, -1), ДобавитьМесяц(НачалоМесяца, 1));
	КонецЕсли;
	// Актуализируем данные
	УстановкаТекущегоПериодаОтображения(ДатаОтображения);
КонецПроцедуры
// Обработчик одинарного клика по полю планировщика
&НаКлиенте
Процедура ПланировщикПередНачаломБыстрогоРедактирования(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

// Обработчик двойного клика по полю планировщика
&НаКлиенте
Процедура ПланировщикПередНачаломРедактирования(Элемент, НовыйЭлемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	// Переопределяем на открытие привязанного по ссылке документа
	ПараметрыФормы = Новый Структура("Ключ", Элемент.ВыделенныеЭлементы[0].Значение);
	ОткрытьФорму("Документ.BKM_ОбслуживаниеКлиентов.Форма.ФормаДокумента", ПараметрыФормы);
КонецПроцедуры 

&НаКлиенте
Процедура ПланировщикПередУдалением(Элемент, Отказ) 
	
	Для каждого УдаляемыйЭлемент Из Элемент.ВыделенныеЭлементы Цикл
		Если 
			ОтображатьЗадачиНесколькихПользователей И 
			УдаляемыйЭлемент.ЗначенияИзмерений["Пользователь"] <> ТекущийПользователь
		Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	СоответствиеДокументовСИзменяемымиДанными = СформироватьСоответствияДокументов(Элемент.ВыделенныеЭлементы, Истина);	
	ИзменениеДокументовНаСервере(СоответствиеДокументовСИзменяемымиДанными, Отказ);
	Если Отказ Тогда
		ПредупреждениеАсинх("Данные не были удалены.", 10, "Невозможность удаления данных");
	КонецЕсли;
	Оповестить("Изменить данные");
КонецПроцедуры 

&НаКлиенте
Процедура ПланировщикПередСозданием(Элемент, Начало, Конец, ЗначенияИзмерений, Текст, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ОтображатьЗадачиНесколькихПользователей И ЗначенияИзмерений["Специалист"] <> ТекущийПользователь Тогда
		Возврат;
	КонецЕсли;
	ОткрытиеФормыСоздаваемогоДокумента(Начало, Конец);	
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикНажатиеНаЭлементеШкалыВремени(Элемент, ЭлементШкалыВремени, Дата)
	// Месяц
	Если ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.Месяц") Тогда 
		// Берем время начала из общих настроек
		Начало = НачалоДня(Дата) + (ВремяНачалаРабочегоДня - Дата(1,1,1));
		Конец = КонецДня(Дата);
	Иначе
		Начало = НачалоЧаса(Дата);
		Конец = Начало + 3600;
	КонецЕсли;
	ОткрытиеФормыСоздаваемогоДокумента(Начало, Конец);
КонецПроцедуры

// Процедура, срабатывающая при попытке перетаскивания элемента планировщика (ссылка на запись в документе)
&НаКлиенте
Процедура ПланировщикПроверкаПеретаскиванияВнутри(Элемент, ПараметрыПеретаскивания, ВариантИзмененияГраниц, ДействиеПеретаскивания, Отказ)
	// Существующий элемент или новый (копируем)
	Если ДействиеПеретаскивания <> ДействиеПеретаскиванияВнутриПланировщика.Выделение Тогда
		// Тип периода - месяц
		Если ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.Месяц") Тогда  
			// Если меняется начало и конец (границы) элементов планировщика 
			Если ВариантИзмененияГраниц = ВариантИзмененияГраницПеретаскиванияВнутриПланировщика.НачалоИКонец Тогда  
				// У каждого сохраняемого элемента сохраняем времена начала и окончания, меняем только даты
				Для каждого Параметр Из ПараметрыПеретаскивания Цикл
					Параметр.ВремяНачалаПлан = Параметр.ВремяНачалаПлан + (Параметр.Элемент.ВремяНачалаПлан - НачалоДня(Параметр.Элемент.ВремяНачалаПлан));
					Параметр.Конец = Параметр.ВремяНачалаПлан + (Параметр.Элемент.Конец - Параметр.Элемент.ВремяНачалаПлан);
				КонецЦикла;
				// Отказываемся от перетаскивания
			Иначе
				Отказ = Истина;
			КонецЕсли;
			//День или неделя	
		Иначе 
			Для каждого Параметр Из ПараметрыПеретаскивания Цикл
					 // Не один и тот же день или разница между временем начала/конца и началом дня меньше указанного 
					СтруктураВремен = ПолучитьВременаНачалаОкончания(Параметр.Начало, Параметр.Конец);
				Если  
					НачалоДня(Параметр.ВремяНачалаПлан) <> НачалоДня(Параметр.Конец) ИЛИ
					СтруктураВремен.ВремяНачалаПлан < ВремяНачалаРабочегоДня ИЛИ
					СтруктураВремен.Конец < ВремяНачалаРабочегоДня ИЛИ
					(ОтображатьЗадачиНесколькихПользователей И
					 Параметр.ЗначенияИзмерений["Пользователь"] <> ТекущийПользователь)
				Тогда
					Отказ = Истина;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры 

&НаКлиенте
Процедура ПланировщикПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)
	Для каждого ВыделенныйЭлемент Из Элемент.ВыделенныеЭлементы Цикл
		Если ВыделенныйЭлемент.ВремяНачалаПлан = Дата(1970,1,1) ИЛИ ВыделенныйЭлемент.Конец = Дата(1970,1,1) Тогда
			ОтменаРедактирования = Истина;
			Возврат;
		КонецЕсли;	
	КонецЦикла;
	// Новые документы
	Если НовыйЭлемент Тогда
		МассивСтруктурДанныхНовыхДокументов = Новый Массив;
		Для каждого ВыделенныйЭлемент Из Элемент.ВыделенныеЭлементы Цикл
			СтруктураДанных = Новый Структура("ВремяНачалаПлан, Конец, СсылкаНаДокумент",
			ВыделенныйЭлемент.ВремяНачалаПлан,
			ВыделенныйЭлемент.Конец,
			ВыделенныйЭлемент.Значение);
			МассивСтруктурДанныхНовыхДокументов.Добавить(СтруктураДанных);
		КонецЦикла;
		
		МассивСсылок = СозданиеДокументовКопированиемНаСервере(МассивСтруктурДанныхНовыхДокументов);
		Для Индекс = 0 По МассивСсылок.ВГраница() Цикл
			Элемент.ВыделенныеЭлементы[Индекс].Значение = МассивСсылок[Индекс];
		КонецЦикла;
		// Существующие документы		
	Иначе
		СоответствиеДокументовСИзменяемымиДанными = СформироватьСоответствияДокументов(Элемент.ВыделенныеЭлементы, Ложь);
		ИзменениеДокументовНаСервере(СоответствиеДокументовСИзменяемымиДанными, ОтменаРедактирования);
	КонецЕсли;
	Оповестить("Изменить данные");
КонецПроцедуры 

&НаКлиенте
Процедура ПланировщикОбработкаФормированияКоманд(Элемент, ПараметрыКоманд, Команды, КомандаПоУмолчанию)
	// Нажимаем по элементу планировщика
	Если ПараметрыКоманд.Источник = ИсточникКомандПланировщика.Элементы Тогда 
		 	//Если ОтображатьЗадачиНесколькихПользователей И ПараметрыКоманд.Элементы[0].ЗначенияИзмерений["Пользователь"] <> ТекущийПользователь

		Если ОтображатьЗадачиНесколькихПользователей И ПараметрыКоманд.Элементы[0].ЗначенияИзмерений["Специалист"] <> ТекущийПользователь
		И ТекущийПользователь <> ЭтоАдминистратор() Тогда
			Команды.Очистить();
			КомандаПоУмолчанию = Неопределено;
			Возврат;
		КонецЕсли;
		
		// Ссылка на документ
		ДокументСсылка = ПараметрыКоманд.Элементы[0].Значение;
		// Описываем команду контекстного меню
		Разделитель = Новый ОписаниеКомандыПоляПланировщика(Неопределено);
		
		Команды.Добавить(Разделитель); 
		
		#Область СозданиеПодменюСКомандамиПоИзменениюСтатуса
		СтатусВыполнено = Новый ОписаниеОповещения("СменаСтатусаВыполнено", ЭтотОбъект, ДокументСсылка);
		СтатусЗапланировано = Новый ОписаниеОповещения("СменаСтатусаЗапланировано", ЭтотОбъект, ДокументСсылка);
		СтатусОтложено = Новый ОписаниеОповещения("СменаСтатусаОтложено", ЭтотОбъект, ДокументСсылка);
		
		КомандаВыполнено = Новый ОписаниеКомандыПоляПланировщика(СтатусВыполнено, "Выполнено");
		КомандаВыполнено.Картинка = БиблиотекаКартинок.ЗаписатьИЗакрыть;
		
		КомандаЗапланировано = Новый ОписаниеКомандыПоляПланировщика(СтатусЗапланировано, "Запланировано");
		КомандаЗапланировано.Картинка = БиблиотекаКартинок.СтартБизнесПроцесса;
		КомандаОтложено = Новый ОписаниеКомандыПоляПланировщика(СтатусОтложено, "Отложено");
		КомандаОтложено.Картинка = БиблиотекаКартинок.Календарь;
		
		СтатусПодменю = Новый Массив;
		СтатусПодменю.Добавить(КомандаВыполнено);
		СтатусПодменю.Добавить(КомандаЗапланировано);
		СтатусПодменю.Добавить(КомандаОтложено);
		
		КомандаСтатус = Новый ОписаниеКомандыПоляПланировщика(СтатусПодменю, "Установить статус");
		КомандаСтатус.Картинка = БиблиотекаКартинок.Задача;
		
		Команды.Добавить(КомандаСтатус);
		#КонецОбласти 
		
		#Область СозданиеПодменюСКомандамиПоИзменениюПриоритета
		ПриоритетВысокий = Новый ОписаниеОповещения("СменаПриоритетаВысокий", ЭтотОбъект, ДокументСсылка);
		ПриоритетСредний = Новый ОписаниеОповещения("СменаПриоритетаСредний", ЭтотОбъект, ДокументСсылка);
		ПриоритетНизкий = Новый ОписаниеОповещения("СменаПриоритетаНизкий", ЭтотОбъект, ДокументСсылка);
		
		КомандаВысокий = Новый ОписаниеКомандыПоляПланировщика(ПриоритетВысокий, "Высокий");
		КомандаВысокий.Картинка = БиблиотекаКартинок.ОформлениеКругКрасный;
		КомандаСредний = Новый ОписаниеКомандыПоляПланировщика(ПриоритетСредний, "Средний");
		КомандаСредний.Картинка = БиблиотекаКартинок.ОформлениеКругЖелтый;
		КомандаНизкий = Новый ОписаниеКомандыПоляПланировщика(ПриоритетНизкий, "Низкий");
		КомандаНизкий.Картинка = БиблиотекаКартинок.ОформлениеКругЗеленый;
		
		ПриоритетПодменю = Новый Массив;
		ПриоритетПодменю.Добавить(КомандаВысокий);
		ПриоритетПодменю.Добавить(КомандаСредний);
		ПриоритетПодменю.Добавить(КомандаНизкий);
		
		КомандаПриоритет = Новый ОписаниеКомандыПоляПланировщика(ПриоритетПодменю, "Установить приоритет");
		КомандаПриоритет.Картинка = БиблиотекаКартинок.ОформлениеКругЧерный;
		
		Команды.Добавить(КомандаПриоритет);	
		#КонецОбласти
		
		#Область ИзменениеЦветаЗадачи
		Команды.Добавить(Разделитель);
		ОписаниеСменыЦвета = Новый ОписаниеОповещения("СменаЦветаКатегории", ЭтотОбъект, ДокументСсылка);
		КомандаСменыЦвета = Новый ОписаниеКомандыПоляПланировщика(ОписаниеСменыЦвета, "Сменить цвет");
		КомандаСменыЦвета.Картинка = БиблиотекаКартинок.ОформлениеЗвездаЗаполненная;
		Команды.Добавить(КомандаСменыЦвета);
		#КонецОбласти
		
	ИначеЕсли ПараметрыКоманд.Источник = ИсточникКомандПланировщика.ПустаяОбластьЭлементов Тогда
		Если 
			ОтображатьЗадачиНесколькихПользователей И
			ПараметрыКоманд.ЗначенияИзмерений["Специалист"] <> ТекущийПользователь
			Тогда
			Команды.Очистить();
			КомандаПоУмолчанию = Неопределено;
		КонецЕсли;
		
	КонецЕсли;	
КонецПроцедуры 

