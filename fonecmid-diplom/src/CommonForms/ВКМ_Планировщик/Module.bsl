#Область СлужебныеПроцедурыИФункции  

&НаСервере
Процедура ЗаполнитьПланировщикНаСервере()
	
	Планировщик.Элементы.Очистить();
	СозданиеИзмерений();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	BKM_ОбслуживаниеКлиентов.Ссылка КАК Ссылка,
	|	BKM_ОбслуживаниеКлиентов.ВремяНачалаПлан КАК Начало,
	|	BKM_ОбслуживаниеКлиентов.ВремяОкончанияПлан КАК Окончание,
	|	BKM_ОбслуживаниеКлиентов.Категория.Представление КАК КатегорияПредставление,
	|	BKM_ОбслуживаниеКлиентов.Категория.Цвет КАК КатегорияЦвет,
	|	BKM_ОбслуживаниеКлиентов.Статус КАК Статус,
	|	BKM_ОбслуживаниеКлиентов.Приоритет КАК Приоритет,
	|	BKM_ОбслуживаниеКлиентов.Комментарий КАК Комментарий,
	|	BKM_ОбслуживаниеКлиентов.Специалист КАК Пользователь,
	|	BKM_ОбслуживаниеКлиентов.ДанныеРасписания КАК ДанныеРасписания,
	|	BKM_ОбслуживаниеКлиентов.ТаблицаПовторов.(
	|		ДатаПовтора КАК ДатаПовтора,
	|		Удаленный КАК Удаленный,
	|		ДатаЗамещения КАК ДатаЗамещения,
	|		ВремяНачалаЗамещения КАК ВремяНачалаЗамещения,
	|		ВремяОкончанияЗамещения КАК ВремяОкончанияЗамещения
	|	) КАК ТаблицаПовторов,
	|	BKM_ОбслуживаниеКлиентов.ДатаПроведенияРабот КАК Дата
	|ИЗ
	|	Документ.BKM_ОбслуживаниеКлиентов КАК BKM_ОбслуживаниеКлиентов
	|ГДЕ
	|	BKM_ОбслуживаниеКлиентов.Специалист В(&Пользователи)
	|	И BKM_ОбслуживаниеКлиентов.ПометкаУдаления = ЛОЖЬ
	|	И (BKM_ОбслуживаниеКлиентов.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|			ИЛИ BKM_ОбслуживаниеКлиентов.ТаблицаПовторов.ДатаПовтора МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|	И (&НетКатегорий
	|			ИЛИ BKM_ОбслуживаниеКлиентов.Категория В (&СписокКатегорий))
	|	И (&НетСтатусов
	|			ИЛИ BKM_ОбслуживаниеКлиентов.Статус В (&СписокСтатусов))
	|	И (&НетПриоритетов
	|			ИЛИ BKM_ОбслуживаниеКлиентов.Приоритет В (&СписокПриоритетов))";
	
	Запрос.УстановитьПараметр("Пользователи", Пользователи);
	Запрос.УстановитьПараметр("ДатаНачала", Планировщик.ТекущиеПериодыОтображения[0].Начало);
	Запрос.УстановитьПараметр("ДатаОкончания", Планировщик.ТекущиеПериодыОтображения[0].Конец); 
	
	Запрос.УстановитьПараметр("СписокКатегорий", Категории);
	Запрос.УстановитьПараметр("СписокСтатусов", Статусы);
	Запрос.УстановитьПараметр("СписокПриоритетов", Приоритеты);
	
	Запрос.УстановитьПараметр("НетКатегорий", НЕ ЗначениеЗаполнено(Категории));
	Запрос.УстановитьПараметр("НетСтатусов", НЕ ЗначениеЗаполнено(Статусы));
	Запрос.УстановитьПараметр("НетПриоритетов", НЕ ЗначениеЗаполнено(Приоритеты));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// Вычисление дат начала и конца для создаваемого элемента планировщика		 
		СтруктураДат = ПолучитьДатыНачалаОкончания(Выборка.Дата, Выборка.Начало, Выборка.Окончание);		
		Элемент = Планировщик.Элементы.Добавить(СтруктураДат.ВремяНачалаПлан, СтруктураДат.Конец);
		// Создание и заполнение данными элемента планировщика
		Элемент.Текст = Выборка.КатегорияПредставление;
		Элемент.Значение = Выборка.Ссылка;
		Элемент.ЦветФона = Выборка.КатегорияЦвет.Получить();
		Элемент.Подсказка = Выборка.Комментарий;
		
		// В зависимости от статуса устанавливаем картинку в элементе планировщика
		Если Выборка.Статус = Перечисления.ВКМ_СтатусыЗадач.Выполнено Тогда
			Элемент.Картинка = БиблиотекаКартинок.ЗаписатьИЗакрыть;
		ИначеЕсли Выборка.Статус = Перечисления.ВКМ_СтатусыЗадач.Запланировано Тогда
			Элемент.Картинка = БиблиотекаКартинок.СтартБизнесПроцесса;
		ИначеЕсли Выборка.Статус = Перечисления.ВКМ_СтатусыЗадач.Отложено Тогда
			Элемент.Картинка = БиблиотекаКартинок.Календарь;
		КонецЕсли;
		
		Элемент.Рамка = Новый Рамка(ТипРамкиЭлементаУправления.Подчеркивание, 5);
		
		// В зависимости от приоритета устанавливаем цвет рамки в элементе планировщика
		Если Выборка.Приоритет = Перечисления.ВКМ_ПриоритетыЗадач.Высокий Тогда
			Элемент.ЦветРамки = Новый Цвет(255,0,0);
		ИначеЕсли Выборка.Приоритет = Перечисления.ВКМ_ПриоритетыЗадач.Средний Тогда
			Элемент.ЦветРамки = Новый Цвет(255,255,0);
		ИначеЕсли Выборка.Приоритет = Перечисления.ВКМ_ПриоритетыЗадач.Низкий Тогда
			Элемент.ЦветРамки = Новый Цвет(0,255,0);		
		КонецЕсли;
		
		// Если тип периода не месяц, то отображаем действие 
		Если ТипПериодаОтображения <> Перечисления.ВКМ_ТипыПериодаОтображения.Месяц И Выборка.Пользователь = ТекущийПользователь Тогда
			ДействиеЦвет = Элемент.Действия.Добавить("ИзменитьЦвет",,БиблиотекаКартинок.ОформлениеЗвездаЗаполненная);
			ДействиеЦвет.Подсказка = "Изменить цвет задачи";
			//ДействиеЦвет.Положение = ПоложениеДействияЭлементаПланировщика.ПослеТекста; (по желанию)
		КонецЕсли;
		
		// Если нужно отображать задачи пользователей, то добавляем значение измерения в элемент
		Если ОтображатьЗадачиНесколькихПользователей Тогда
			Измерения = Новый Соответствие;
			Измерения.Вставить("Специалист", Выборка.Пользователь);
			Элемент.ЗначенияИзмерений = Новый ФиксированноеСоответствие(Измерения);
			Если Выборка.Пользователь <> ТекущийПользователь Тогда
				Элемент.РежимРазрешенияРедактирования = РежимРазрешенияРедактированияЭлементаПланировщика.ЗапретитьПеретаскиваниеИРастягивание;
			КонецЕсли;
		КонецЕсли;

		// Получаем расписание из реквизита ХранилищеЗначения в документе
		Элемент.Расписание = Выборка.ДанныеРасписания.Получить(); 
		// Добавляем в расписание замещающие элементы, если они присутствуют
		ВыборкаПовторов = Выборка.ТаблицаПовторов.Выбрать();
		Пока ВыборкаПовторов.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаПовторов.ДатаЗамещения) ИЛИ ВыборкаПовторов.Удаленный Тогда
				ЭлементЗамещения = Элемент.ЗамещающиеЭлементы.Добавить(ВыборкаПовторов.ДатаПовтора + (Выборка.Начало - Дата(1,1,1)));
				СтруктураДатЗамещения = ПолучитьДатыНачалаОкончания(ВыборкаПовторов.ДатаЗамещения, 
																	ВыборкаПовторов.ВремяНачалаЗамещения,
																	ВыборкаПовторов.ВремяОкончанияЗамещения);		
				ЭлементЗамещения.ВремяНачалаПлан = СтруктураДатЗамещения.ВремяНачалаПлан;
				ЭлементЗамещения.Конец = СтруктураДатЗамещения.Конец;
				ЭлементЗамещения.Удаленный = ВыборкаПовторов.Удаленный;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура СозданиеИзмерений() 
	Планировщик.Измерения.Очистить();
	Если ОтображатьЗадачиНесколькихПользователей Тогда
		// Отобразим измерения (пользователей) 
		ИзмерениеПользователи = Планировщик.Измерения.Добавить("Специалист");
		Для каждого ЭлементСписка Из Пользователи Цикл
			ЭлементИзмерения = ИзмерениеПользователи.Элементы.Добавить(ЭлементСписка.Значение, ЭлементСписка.Значение.Наименование);
			Если ЭлементИзмерения.Значение <> ТекущийПользователь Тогда
				// сине-белый другие
				ЭлементИзмерения.ЦветФона = Новый Цвет(80, 0, 145);
				ЭлементИзмерения.ЦветТекста = Новый Цвет(255, 255, 255);
			Иначе
				ЭлементИзмерения.ЦветТекста = Новый Цвет(0,0,0);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура НастройкаСвойствПланировщика()
	// Месяц
	Если ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.Месяц") Тогда
		// Дни будут сверху
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Верх;
		
		// Отключаем видимость второй шкалы времени
		ШкалаМинуты = Планировщик.ШкалаВремени.Элементы[1];
		ШкалаМинуты.Видимость = Ложь;
		
		// Настройка единственной видимой шкалы времени
		Шкала = Планировщик.ШкалаВремени.Элементы[0];	
		Шкала.Единица = ТипЕдиницыШкалыВремени.День;
		Шкала.Кратность = 1;
		// День недели и дата
		Шкала.Формат = "ДФ='ддд, дд МММ гггг'";
		// Выделение цветами заголовков дней
		Шкала.ЦветФона = WebЦвета.ГрифельноСерый; 
		Шкала.ЦветЛиний = WebЦвета.Черный;
		Шкала.ЦветТекста = WebЦвета.Белый;
		
		// Переносим шкалу через каждые 7 дней
		Планировщик.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.День;
		Планировщик.КратностьПериодическогоВарианта = 7;
		// Не пропускаем дни
		Планировщик.ОтступСНачалаПереносаШкалыВремени = 0;
		Планировщик.ОтступСКонцаПереносаШкалыВремени = 0;
		// Отображение времени начала и конца 
		Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.ВремяНачалаИКонца;
		// Отключаем встроенные заголовки
		Планировщик.ОтображатьПеренесенныеЗаголовки = Ложь;
		
	Иначе 
		//Время слева
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Лево; 
		
		// Включаем видимость второй шкалы времени для создания элементов, кратных 5 минутам
		ШкалаМинуты = Планировщик.ШкалаВремени.Элементы[1];
		ШкалаМинуты.Видимость = Истина;  
		
		// Настройка единственной видимой шкалы времени
		Шкала = Планировщик.ШкалаВремени.Элементы[0];
		Шкала.Единица = ТипЕдиницыШкалыВремени.Час;
		Шкала.Кратность = 1;
		// Формата "Часы:Минуты"
		Шкала.Формат = "ДФ='ЧЧ:мм'";
		// Цвета шкал времени ставим по умолчанию
		Шкала.ЦветФона = Новый Цвет(); 
		Шкала.ЦветЛиний = Новый Цвет();
		Шкала.ЦветТекста = Новый Цвет();
		
		// Перенос шкалы каждые 24 часа 
		Планировщик.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.Час;
		Планировщик.КратностьПериодическогоВарианта = 24; 
		// пропускаем первые N часов
		Планировщик.ОтступСНачалаПереносаШкалыВремени = Час(ВремяНачалаРабочегоДня);
		Планировщик.ОтступСКонцаПереносаШкалыВремени = 0;
		// Отображение времени начала 
		Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.ВремяНачала;	
		// Включаем встроенные заголовки
		Планировщик.ОтображатьПеренесенныеЗаголовки = Истина;	
		
	КонецЕсли;
КонецПроцедуры

// Выделяем дни, не относящиеся к месяцу 
&НаКлиенте
Процедура НастройкаИнтерваловФона()
	// Очищаем коллекцию интервалов
	Планировщик.ИнтервалыФона.Очистить();  
	
	// Вычисляем начало и конец отображаемого периода
	НачалоПериода = Планировщик.ТекущиеПериодыОтображения[0].Начало;
	КонецПериода = Планировщик.ТекущиеПериодыОтображения[0].Конец;
	
	// Если тип периода не месяц, то интервалы фона не создаем
	Если ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.Месяц") Тогда
		// Выделение цветом ячеек перед текущим месяцем, если такие ячейки есть
		Если НачалоМесяца > НачалоПериода Тогда
			ИнтервалФона = Планировщик.ИнтервалыФона.Добавить(НачалоПериода, НачалоМесяца - 1);
			ИнтервалФона.Цвет = WebЦвета.ГрифельноСерый;
		КонецЕсли;
		// Выделение цветом ячеек после текущего месяца, если такие ячейки есть
		Если КонецМесяца < КонецПериода Тогда
			ИнтервалФона = Планировщик.ИнтервалыФона.Добавить(КонецМесяца + 1, КонецПериода);
			ИнтервалФона.Цвет = WebЦвета.ГрифельноСерый;
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановкаТекущегоПериодаОтображения(ДатаОтображения)
	// Месяц
	Если ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.Месяц") Тогда
		// Начало и конец месяца
		НачалоМесяца = НачалоМесяца(ДатаОтображения);
		КонецМесяца = КонецМесяца(ДатаОтображения);
		// Представление периода (для заголовка формы)
		ПредставлениеПериода = ПредставлениеПериода(НачалоМесяца, КонецМесяца); 
		
		// Вычисляем недели для первого и последнего дня месяца
		НачалоПериода = НачалоНедели(НачалоМесяца);
		КонецПериода = КонецНедели(КонецМесяца);
		
		// Если период отображения - неделя или день
	Иначе
		НачалоПериода = ?(ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.Неделя")
		,
		НачалоНедели(ДатаОтображения), НачалоДня(ДатаОтображения));
		КонецПериода = ?(ТипПериодаОтображения = ПредопределенноеЗначение("Перечисление.ВКМ_ТипыПериодаОтображения.Неделя"),
		КонецНедели(ДатаОтображения), КонецДня(ДатаОтображения));
		ПредставлениеПериода = ПредставлениеПериода(НачалоПериода, КонецПериода);
	КонецЕсли;
	
	// Очищаем коллекцию периодов
	Планировщик.ТекущиеПериодыОтображения.Очистить();
	// Добавляем в коллекцию новый элемент 
	Планировщик.ТекущиеПериодыОтображения.Добавить(НачалоПериода, КонецПериода);
	//Формируем заголовок формы на основе периода
	Заголовок = "Период: " + ПредставлениеПериода;  
	Календарь = НачалоПериода;
	НастройкаИнтерваловФона();
	// Перезаполнение данными планировщика
	ЗаполнитьПланировщикНаСервере();	
КонецПроцедуры 

&НаКлиенте
Функция СформироватьСоответствияДокументов(ВыделенныеЭлементы, Удаление)
	СоответствиеДокументовСИзменяемымиДанными = Новый Соответствие;
	Для каждого УдаляемыйЭлемент Из ВыделенныеЭлементы Цикл
		Если СоответствиеДокументовСИзменяемымиДанными.Получить(УдаляемыйЭлемент.Значение) = Неопределено Тогда
			СоответствиеДокументовСИзменяемымиДанными.Вставить(УдаляемыйЭлемент.Значение, Новый Массив);
		КонецЕсли;
		СтруктураДанных = Новый Структура("ДатаЗамещения, ВремяНачалаПлан, Конец, Удаление");
		СтруктураДанных.ДатаЗамещения = УдаляемыйЭлемент.ДатаЗамещения;
		СтруктураДанных.Начало = УдаляемыйЭлемент.ВремяНачалаПлан;
		СтруктураДанных.Конец = УдаляемыйЭлемент.Конец;
		СтруктураДанных.Удаление = Удаление;
		СоответствиеДокументовСИзменяемымиДанными[УдаляемыйЭлемент.Значение].Добавить(СтруктураДанных);
	КонецЦикла;
	Возврат СоответствиеДокументовСИзменяемымиДанными;
КонецФункции 

&НаСервереБезКонтекста
Процедура ИзменениеДокументовНаСервере(СоответствиеДокументовСИзменяемымиДанными, Отказ)
	
	Для каждого ЭлементСоответствия Из СоответствиеДокументовСИзменяемымиДанными Цикл
		// Блокировка данных от пользователя
		Попытка
			ЗаблокироватьДанныеДляРедактирования(ЭлементСоответствия.Ключ);
		Исключение
			// Невозможность блокировки при ведущейся работе
			ТекстСообщения = СтрШаблон("С задачей ""%1"" уже взаимодействуют.", ЭлементСоответствия.Ключ);
			Сообщить(ТекстСообщения);
			Отказ = Истина;
		КонецПопытки;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ЭлементСоответствия Из СоответствиеДокументовСИзменяемымиДанными Цикл
		ДокументОбъект = ЭлементСоответствия.Ключ.ПолучитьОбъект();
		Для каждого СтруктураДанных Из ЭлементСоответствия.Значение Цикл
			//ДокументОбъект = Документы.Задачи.СоздатьДокумент();(подсказка)
			// Проверяем надо ли удалять документ без повторов
			Если НЕ ДокументОбъект.ЕстьПовтор Тогда	
				Если СтруктураДанных.Удаление Тогда
					ДокументОбъект.УстановитьПометкуУдаления(Истина);	
				Иначе
					ДокументОбъект.Дата = НачалоДня(СтруктураДанных.ВремяНачалаПлан);					
					СтруктураВремен = ПолучитьВременаНачалаОкончания(СтруктураДанных.ВремяНачалаПлан, СтруктураДанных.Конец);
					ДокументОбъект.ВремяНачалаПлан = СтруктураВремен.ВремяНачалаПлан;
					ДокументОбъект.ВремяОкончанияПлан = СтруктураВремен.Конец;
					ДокументОбъект.Записать();
				КонецЕсли;		
			Иначе
				// Производим поиск в таблице повторов документа по значению даты повтора
				СтрокаПовтора = ДокументОбъект.ТаблицаПовторов.Найти(НачалоДня(СтруктураДанных.ДатаЗамещения), "ДатаПовтора"); 
				// Заполняем данные
				СтрокаПовтора.ДатаЗамещения = НачалоДня(СтруктураДанных.ВремяНачалаПлан);
				СтруктураВременЗамещения = ПолучитьВременаНачалаОкончания(СтруктураДанных.ВремяНачалаПлан, СтруктураДанных.Конец);				
				СтрокаПовтора.ВремяНачалаЗамещения = СтруктураВременЗамещения.ВремяНачалаПлан;
				СтрокаПовтора.ВремяОкончанияЗамещения = СтруктураВременЗамещения.Конец;
				СтрокаПовтора.Удаленный = СтруктураДанных.Удаление;
				ДокументОбъект.Записать();
			КонецЕсли;	
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция СозданиеДокументовКопированиемНаСервере(МассивСтруктурДанныхНовыхДокументов)
	МассивСсылок = Новый Массив;
	Для каждого СтруктураДанных Из МассивСтруктурДанныхНовыхДокументов Цикл
		НовыйДокумент = Документы.BKM_ОбслуживаниеКлиентов.СоздатьДокумент();
		НовыйДокумент.Дата = НачалоДня(СтруктураДанных.ВремяНачалаПлан);
		
		ВременаДокумента = ПолучитьВременаНачалаОкончания(СтруктураДанных.ВремяНачалаПлан, СтруктураДанных.Конец);
		
		НовыйДокумент.ВремяНачалаПлан = ВременаДокумента.ВремяНачалаПлан;
		НовыйДокумент.ВремяОкончанияПлан = ВременаДокумента.Конец;
		
		НовыйДокумент.Категория = СтруктураДанных.СсылкаНаДокумент.Категория;
		НовыйДокумент.Статус = СтруктураДанных.СсылкаНаДокумент.Статус;
		НовыйДокумент.Приоритет = СтруктураДанных.СсылкаНаДокумент.Приоритет;
		НовыйДокумент.Записать();
		МассивСсылок.Добавить(НовыйДокумент.Ссылка);
	КонецЦикла;
	Возврат МассивСсылок;
КонецФункции  


