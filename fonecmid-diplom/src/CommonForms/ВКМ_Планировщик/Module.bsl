&НаКлиенте
Процедура ОткрытиеФормыСоздаваемогоДокумента(Начало, Конец)
	// Определяем дату, время начала и окончания для передачи новому документу
	ЭлементыЗаполнения = Новый Структура("ДатаПроведенияРабот, ВремяНачалаПлан, ВремяОкончанияПлан, Специалист");
	ЭлементыЗаполнения.ДатаПроведенияРабот = НачалоДня(Начало);
	ЭлементыЗаполнения.Специалист = ТекущийПользователь;
	
	СтруктураВремен = ПолучитьВременаНачалаОкончания(Начало, Конец);
	
	ЭлементыЗаполнения.ВремяНачалаПлан = ?(ЗначениеЗаполнено(СтруктураВремен.ВремяНачалаПлан), 
		СтруктураВремен.ВремяНачалаПлан, 
		ВремяНачалаРабочегоДня);
		
	ЭлементыЗаполнения.ВремяОкончанияПлан = ?(ЗначениеЗаполнено(СтруктураВремен.Конец), 
		СтруктураВремен.Конец, 
		Дата(1,1,1, 23,59,59));
		
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЭлементыЗаполнения);
	ОткрытьФорму("Документ.BKM_ОбслуживаниеКлиентов.Форма.ФормаДокумента", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьВременаНачалаОкончания(ДатаНачала, ДатаОкончания)
	Начало = Дата(1,1,1) + (ДатаНачала - НачалоДня(ДатаНачала));
	Конец = Дата(1,1,1) + (ДатаОкончания - НачалоДня(ДатаОкончания));
	
	Возврат Новый Структура("ВремяНачалаПлан, Конец", Начало, Конец);
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьДатыНачалаОкончания(ДатаБезВремени, ДатаНачала, ДатаОкончания)
	Начало = ДатаБезВремени + (ДатаНачала - Дата(1,1,1));
	Конец = ДатаБезВремени + (ДатаОкончания - Дата(1,1,1));
	
	Возврат Новый Структура("ВремяНачалаПлан, Конец", Начало, Конец);
КонецФункции  

